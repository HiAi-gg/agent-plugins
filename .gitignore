# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
coverage/
*.tsbuildinfo

# Temp / local
.tmp/
temp/
.temp/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / IDE
.idea/
