# Example environment variables for Agent Plugins in this collection.
# All values here are FAKE / non-secret placeholders. Never commit real secrets.

# PostgreSQL (plugins/postgresql): standard PostgreSQL connection string.
DATABASE_URL=postgresql://user:replace-with-your-password@localhost:5432/database

# Firecrawl (plugins/firecrawl): optional API key for crawl/extract (client-level).
# FIRECRAWL_API_KEY=fc-replace-me
